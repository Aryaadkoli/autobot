# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# user-uploaded content (template images/pamphlets)
/public/uploads/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors — keep tasks.json (team dev-server autostart, see README) and
# extensions.json (recommended extensions), ignore everyone's personal
# settings/launch configs
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
