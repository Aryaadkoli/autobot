# Copy this file to .env and fill in real values. Never commit .env itself
# (already in .gitignore).

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/autobot_local

# NextAuth session encryption — generate with: npx auth secret
AUTH_SECRET=

# The seeded owner account's login password (prisma/seed.ts). Re-running
# `npx prisma db seed` resets it back to this value.
SEED_ADMIN_PASSWORD=changeme123

# Meta (WhatsApp Cloud API) webhook verification — see docs/BLUEPRINT.md
# and Settings → WhatsApp connection in the app for full setup steps.
# Placeholders are fine for local dev; the app falls back to a mock
# channel adapter until a tenant's real WhatsApp credentials are saved
# through the Settings page (those are stored encrypted in the database,
# not here).
META_APP_SECRET=
META_VERIFY_TOKEN=

# Encrypts per-tenant channel credentials (WhatsApp access tokens, etc.)
# at rest — lib/crypto.ts. Any passphrase string; scrypt derives a proper
# key from it. Generate with: openssl rand -base64 32
CREDENTIALS_KEY=

# Workflow engine (core/workflow) — BullMQ delayed jobs for "wait" steps.
# Local dev: `docker run -d --name autobot-redis -p 6379:6379 redis` (or
# `docker start autobot-redis` if the container already exists).
REDIS_URL=redis://127.0.0.1:6379

# This app's own public URL — used to build /r/{token} link-tracking
# redirects and publicly-reachable template media URLs. Leave unset for
# local dev (defaults to http://localhost:3000, though Meta's servers
# can't actually reach that — only matters once this is deployed).
# APP_URL=https://your-domain.example

# Account emails (welcome on signup, teammate invites) via Gmail SMTP —
# lib/mailer.ts. Leave both unset to log emails to the console instead of
# sending. To make it real: Google Account → Security → 2-Step
# Verification (must be on) → App passwords → generate one for "Mail" →
# paste the 16-character result below (no spaces).
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=

# Overrides the in-process scheduler's poll interval (ms) — only useful
# for testing; defaults to 60000 (1 minute) if unset.
# SCHEDULER_INTERVAL_MS=60000
