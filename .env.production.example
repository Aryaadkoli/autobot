# Production .env for the VM — copy to `.env` in the project root there
# and fill in real values. This is what docker-compose.yml's `env_file:`
# directive loads into the web/worker containers (DATABASE_URL and
# REDIS_URL are the two exceptions — compose sets those itself, using
# the postgres/redis service names as hostnames, so don't set them here).
#
# DB_PASSWORD is the one variable docker-compose.yml substitutes directly
# (${DB_PASSWORD}) rather than passing through to the containers — it has
# to be run with `docker compose --env-file .env up -d` for that
# substitution to actually read this file (compose's own ${VAR}
# substitution and a service's `env_file:` are two separate mechanisms —
# see CLAUDE.md for the full story on this gotcha).

# A long random password for the Postgres container — generate with:
# openssl rand -base64 24
DB_PASSWORD=

# NextAuth session encryption — generate a fresh one for production, do
# NOT reuse the dev value: npx auth secret
AUTH_SECRET=

# The production owner account's login password — set this to the real
# secure password (the one emailed to you), then run
# `docker compose exec web npx tsx prisma/seed.prod.ts` once, the very
# first time the stack comes up. Safe to leave set afterward; the seed
# script is idempotent and only touches the owner account.
SEED_ADMIN_PASSWORD=

# Meta (WhatsApp Cloud API) — deferred for now (see CLAUDE.md). Leave
# blank until a real WhatsApp Business number is connected; the app
# works fine without it, WhatsApp sends just won't go out for real yet.
META_APP_SECRET=
META_VERIFY_TOKEN=

# Encrypts per-tenant channel credentials at rest — generate a fresh one
# for production, do NOT reuse the dev value: openssl rand -base64 32
CREDENTIALS_KEY=

# This app's own public URL — used to build /r/{token} link-tracking
# redirects and template media URLs that Meta's servers need to reach.
# Must be the real domain, with https://.
APP_URL=https://autobot.urvanidhi.com

# Account emails (welcome on signup, teammate invites) via Gmail SMTP.
# Same account already used in dev — urvanidhi@gmail.com — see lib/mailer.ts.
GMAIL_USER=urvanidhi@gmail.com
GMAIL_APP_PASSWORD=
