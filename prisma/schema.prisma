// Autobot Orchestration Platform — complete database schema
// PostgreSQL + Prisma. Every business table carries tenantId — ALWAYS filter on it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// TENANCY & USERS
// ─────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // used in URLs, e.g. app.autobot.in/t/alpha-corp
  timezone  String   @default("Asia/Kolkata")
  plan      Plan     @default(FREE)

  // Channel credentials (encrypt access tokens at rest with libsodium/secretbox)
  waPhoneNumberId   String? // Meta Cloud API phone number ID
  waBusinessAcctId  String? // WABA ID
  waAccessTokenEnc  String? // encrypted
  brevoApiKeyEnc    String? // encrypted

  // Platform-wide guardrails
  dailyCapPerContact Int @default(3)   // frequency cap: max messages/contact/24h
  quietHoursStart    Int @default(21)  // no sends after 21:00 local
  quietHoursEnd      Int @default(9)   // no sends before 09:00 local

  createdAt DateTime @default(now())

  users         User[]
  roles         Role[]
  businessTypes BusinessType[]
  services      Service[]
  contacts      Contact[]
  tags          Tag[]
  tagRules      TagRule[]
  imports       Import[]
  events        Event[]
  workflows     Workflow[]
  instances     SequenceInstance[]
  templates     MessageTemplate[]
  messages      Message[]
  links         Link[]
  apiKeys       ApiKey[]
  campaigns     Campaign[]
  scheduledCampaigns ScheduledCampaign[]
}

enum Plan {
  FREE
  PAID
}

// The login identity — one email, one password, global (not per-tenant).
// A person signs in as an Account, then picks (or is auto-placed into) a
// Tenant via their User memberships below. This is what makes "one email,
// several businesses" possible: aryaadkoli@gmail.com can be OWNER of one
// Tenant and ADMIN of another via two separate User rows sharing this one
// Account, instead of two disconnected logins with separate passwords.
model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships User[]
}

// One person's membership in one Tenant — the role they hold there. All
// the "who can do what" checks (session.role, requireSession().tenantId)
// still key off this row exactly as before; only identity moved out to
// Account.
model User {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  accountId String
  account   Account   @relation(fields: [accountId], references: [id])
  roleId    String
  role      Role      @relation(fields: [roleId], references: [id])
  createdAt DateTime  @default(now())
  deletedAt DateTime? // set instead of a hard delete when a teammate is
                       // removed — see lib/db.ts's soft-delete extension.

  // A removed teammate is soft-deleted (deletedAt set), and this
  // constraint stays a genuine, unconditional unique index — Postgres
  // can't target a partial index from .upsert()'s ON CONFLICT clause
  // (confirmed live: an earlier version of this migration tried that and
  // every upsert on this table threw). Practical effect: re-inviting a
  // removed teammate reuses their existing (soft-deleted) User row
  // rather than creating a new one — see app/api/users/route.ts.
  @@unique([tenantId, accountId])
}

// Per-tenant roles. Every tenant gets three system roles seeded on
// creation (OWNER / CO_OWNER / MEMBER, isSystem: true) — the app's OWNER
// checks (session.role === "OWNER") depend on that exact name existing,
// so system roles can never be renamed or deleted. OWNER and CO_OWNER
// always have full access and never get RolePermission rows (see
// lib/permissions.ts) — CO_OWNER's one restriction (can't remove an
// OWNER/CO_OWNER account) is hardcoded there too, not modeled as a
// permission. MEMBER and any custom role the owner creates are governed
// entirely by their RolePermission rows.
model Role {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String    // "OWNER" / "CO_OWNER" / "MEMBER" or a custom name
  isSystem  Boolean   @default(false)
  deletedAt DateTime? // set instead of a hard delete when the role is
                       // still assigned to someone at delete time; a
                       // soft-deleted role keeps working for whoever
                       // already has it, it just stops being offered
                       // when assigning a role to someone new. Because
                       // this is a genuine unique constraint (not
                       // partial — see the User model's comment above),
                       // recreating a role with the same name as a
                       // soft-deleted one resurrects it instead of
                       // making a second row — see app/api/roles/route.ts.
  createdAt DateTime  @default(now())
  users     User[]
  permissions RolePermission[]

  @@unique([tenantId, name])
}

// What a role can see/do per feature area of the app. OWNER and CO_OWNER
// bypass this entirely (see lib/permissions.ts) — they always have full
// view+edit on everything and never get rows here. Every other role
// (MEMBER and any custom role) is governed by whatever rows exist for
// it; a module with no row at all means no access, same as canView/
// canEdit both false.
model RolePermission {
  id      String  @id @default(cuid())
  roleId  String
  role    Role    @relation(fields: [roleId], references: [id])
  module  Module
  canView Boolean @default(false)
  canEdit Boolean @default(false)

  @@unique([roleId, module])
}

enum Module {
  LEADS      // Contacts, tags, tag rules, imports
  TEMPLATES
  CAMPAIGNS  // Campaigns + scheduled campaigns
  WORKFLOWS
  ANALYTICS
  TEAM       // Team members + roles (view/edit here does NOT let a non-owner
             // touch an OWNER/CO_OWNER account — see lib/permissions.ts)
  SETTINGS   // WhatsApp connection, sending limits
}

// ─────────────────────────────────────────────
// HIERARCHY: Company(=Tenant) → BusinessType → Service → Contact
// ─────────────────────────────────────────────

model BusinessType {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  name     String    // e.g. "Distribution", "Retail"
  services Service[]
  contacts Contact[]

  @@unique([tenantId, name])
}

model Service {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  businessTypeId String
  businessType   BusinessType @relation(fields: [businessTypeId], references: [id])
  name           String       // e.g. "New product leads"
  type           ServiceType
  priority       Int          // LOWER number = HIGHER priority. PAYMENT=10, LEAD=50...
  workflows      Workflow[]

  @@unique([tenantId, name])
}

enum ServiceType {
  LEAD
  PAYMENT
  STOCK
  AUTO_PO
  CUSTOM
}

// ─────────────────────────────────────────────
// CONTACTS, TAGS, RULES
// ─────────────────────────────────────────────

model Contact {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  phone          String        // E.164, e.g. +919812345678 — primary identity in India
  email          String?
  name           String?
  businessTypeId String?
  businessType   BusinessType? @relation(fields: [businessTypeId], references: [id])

  // Free-form business data from Excel/ERP: {"city":"Pune","last_order_date":"2026-06-01","credit_days":30}
  attributes Json @default("{}")

  // Consent — survival features, not checkboxes
  waOptedOut    Boolean @default(false)
  emailOptedOut Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // set instead of a hard delete — see lib/db.ts's
                       // soft-delete extension.

  tags      ContactTag[]
  events    Event[]
  instances SequenceInstance[]
  messages  Message[]

  // Dedupe key on import — a genuine unique constraint (see the User
  // model's comment above for why it's not partial). A deleted contact's
  // phone number stays reserved by that row; core/ingestion/upsert.ts
  // resurrects it on a matching re-import instead of erroring.
  @@unique([tenantId, phone])
  @@index([tenantId, businessTypeId])
}

model Tag {
  id       String       @id @default(cuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  name     String       // "dormant-30d", "high-value", "interested-productX"
  deletedAt DateTime?    // set instead of a hard delete — see lib/db.ts's
                          // soft-delete extension.
  contacts ContactTag[]
  rules    TagRule[]
  scheduledCampaigns ScheduledCampaign[]

  // Genuine unique constraint (see the User model's comment above for
  // why) — a deleted tag's name stays reserved; core/ingestion/upsert.ts
  // resurrects it when the same name is used again via bulk import.
  @@unique([tenantId, name])
}

model ContactTag {
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id])
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id])
  addedAt   DateTime @default(now())

  @@id([contactId, tagId])
}

// The Categorization Script from the spec — rules stored as data, editable in UI later
model TagRule {
  id       String     @id @default(cuid())
  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  name     String     // "Mark dormant after 30 days"
  // Condition tree, e.g.:
  // {"all":[{"attr":"last_order_date","op":"olderThanDays","value":30},
  //         {"attr":"city","op":"eq","value":"Pune"}]}
  condition Json
  tagId     String
  tag       Tag        @relation(fields: [tagId], references: [id])
  runOn     RuleRunOn  @default(BOTH)
  active    Boolean    @default(true)
}

enum RuleRunOn {
  INGEST   // evaluate when a contact is imported/updated
  SCHEDULE // evaluate in the nightly sweep (for time-based conditions)
  BOTH
}

// ─────────────────────────────────────────────
// INGESTION
// ─────────────────────────────────────────────

model Import {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  filename      String
  // {"Mobile No":"phone","Customer Name":"name","City":"attributes.city"}
  columnMapping Json
  status        ImportStatus @default(PENDING)
  totalRows     Int          @default(0)
  importedRows  Int          @default(0)
  failedRows    Int          @default(0)
  errorReport   Json?        // [{row: 14, error: "invalid phone"}]
  createdAt     DateTime     @default(now())
}

enum ImportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String    // "ERP webhook key"
  keyHash    String    @unique // store SHA-256, show plaintext once at creation
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ─────────────────────────────────────────────
// EVENTS — append-only source of truth
// Both behavior triggers AND analytics read from here.
// ─────────────────────────────────────────────

model Event {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id])
  type       EventType
  payload    Json      @default("{}") // {"messageId":"...","url":"...","amount":5000}
  occurredAt DateTime  @default(now())

  @@index([tenantId, contactId, type, occurredAt])
  @@index([tenantId, occurredAt]) // analytics scans
}

enum EventType {
  IMPORTED
  UPDATED
  MSG_SENT
  MSG_DELIVERED
  MSG_READ
  MSG_FAILED
  LINK_CLICKED
  REPLIED
  PAYMENT_RECEIVED
  ORDER_PLACED
  OPTED_OUT
  CUSTOM // from the ingest API, payload carries details
}

// ─────────────────────────────────────────────
// WORKFLOWS & SEQUENCES
// ─────────────────────────────────────────────

model Workflow {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  serviceId String
  service   Service        @relation(fields: [serviceId], references: [id])
  name      String
  version   Int            @default(1)
  isSubflow Boolean        @default(false) // sub-flows are pivot targets, not entered directly
  status    WorkflowStatus @default(DRAFT)
  // The playbook — see workflow-format.md for the JSON structure
  definition Json
  createdAt  DateTime      @default(now())
  deletedAt  DateTime?     // set instead of a hard delete — see
                            // lib/db.ts's soft-delete extension.

  instances SequenceInstance[]

  // Genuine unique constraint (see the User model's comment above) — a
  // deleted workflow's (name, version) stays reserved; bump the version
  // to reuse the name, same as any other name clash.
  @@unique([tenantId, name, version])
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// One row per (contact × workflow run) — the "State Table" from the spec
model SequenceInstance {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id])
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id])

  currentStepId String?
  status        InstanceStatus @default(ACTIVE)
  wakeAt        DateTime?      // when the pending delayed job fires
  waitingFor    EventType?     // which behavior event would transition this instance
  bullJobId     String?        // pending BullMQ job — cancel it on pivot

  pivotedToId String? // instance id of the sub-flow this pivoted into
  context     Json    @default("{}") // per-run variables, e.g. {"invoice_no":"INV-201"}

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([tenantId, contactId, status]) // "does this contact have an active payment flow?"
  @@index([status, wakeAt])              // worker sweep safety net
  @@index([tenantId, workflowId, status]) // analytics: conversion per workflow
}

enum InstanceStatus {
  ACTIVE
  COMPLETED  // reached an end step — this is a "conversion"
  PIVOTED    // killed by a CTA, sub-flow started
  CANCELLED  // manual stop or opt-out
  SUPPRESSED // gatekeeper blocked it permanently (e.g. opted out mid-flow)
}

// ─────────────────────────────────────────────
// TEMPLATES & MESSAGES
// ─────────────────────────────────────────────

model MessageTemplate {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String  // internal name used in workflow JSON: "payment_reminder_1"
  channel  Channel

  // WhatsApp: Meta template name + category (drives cost: UTILITY ≈ ₹0.115 vs MARKETING ≈ ₹0.86)
  metaTemplateName String?
  metaCategory     MetaCategory?
  metaLanguage     String?       @default("en")

  // Header media for WhatsApp templates (image or PDF pamphlet)
  mediaUrl  String?
  mediaType MediaType?

  body           String // with {{1}}, {{2}} placeholders (or {{name}} for email)
  variables      Json   @default("[]") // [{"pos":1,"source":"contact.name"},{"pos":2,"source":"context.invoice_no"}]
  approvalStatus TemplateApproval @default(PENDING)
  createdAt      DateTime @default(now())
  deletedAt      DateTime? // set instead of a hard delete — see
                            // lib/db.ts's soft-delete extension.

  messages  Message[]
  campaigns Campaign[]
  scheduledCampaigns ScheduledCampaign[]

  // Genuine unique constraint (see the User model's comment above) — a
  // deleted template's name stays reserved until it's picked again with
  // a different name (mirrors the existing "name already exists" error).
  @@unique([tenantId, name])
}

// A planned future send — "on this date, send this template to this
// segment." A lightweight stand-in for the real workflow engine (Phase 4):
// no recurrence, no behavior triggers, just "at time X, run this campaign."
// Picked up by the in-process scheduler in instrumentation.ts.
model ScheduledCampaign {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  templateId String
  template   MessageTemplate @relation(fields: [templateId], references: [id])
  name       String   // e.g. "Mango farmers — January reminder"

  tagId String?
  tag   Tag?    @relation(fields: [tagId], references: [id])
  stage String?

  scheduledFor DateTime
  recurrence   ScheduledCampaignRecurrence @default(NONE)
  status       ScheduledCampaignStatus @default(PENDING)
  ranCampaignId String? // points to the Campaign history row once it runs
  errorMessage  String?

  createdAt DateTime @default(now())

  @@index([status, scheduledFor])
}

enum ScheduledCampaignRecurrence {
  NONE
  MONTHLY
  YEARLY
}

enum ScheduledCampaignStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

// One row per Campaigns-page send — a lightweight run log (not the full
// enrollment/state-machine model Phase 4's workflow engine will bring).
model Campaign {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id])
  source     String           // e.g. "Tag: High-Value Customer", "Uploaded list: leads.xlsx"

  targetedCount Int
  sentCount     Int
  failedCount   Int
  skippedCount  Int

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

enum Channel {
  WHATSAPP
  EMAIL
}

enum MetaCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum MediaType {
  IMAGE
  DOCUMENT
}

enum TemplateApproval {
  PENDING
  APPROVED
  REJECTED
}

model Message {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  contactId  String
  contact    Contact          @relation(fields: [contactId], references: [id])
  instanceId String?          // null for one-off/manual sends
  stepId     String?
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id])
  channel    Channel

  // THE idempotency key: `${instanceId}:${stepId}` (or `manual:${uuid}`)
  // Worker refuses to send if this key already exists → no double sends, ever.
  dedupeKey String @unique

  providerMessageId String?       // Meta wamid / provider request id — webhook lookups
  status            MessageStatus @default(QUEUED)
  error             String?
  costPaise         Int?          // track spend: 12 = ₹0.115 utility, 86 = marketing
  renderedBody      String?       // what was actually sent, for the conversation view

  sentAt          DateTime?
  statusUpdatedAt DateTime  @default(now())
  createdAt       DateTime  @default(now())

  links Link[]

  @@index([tenantId, contactId, sentAt]) // frequency-cap query
  @@index([providerMessageId])           // status webhook lookup
  @@index([tenantId, createdAt])         // analytics
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SUPPRESSED // gatekeeper blocked (cap / quiet hours / priority / opt-out)
}

// Every outbound URL is rewritten to autobot.in/r/{token} → click = trackable event
model Link {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  messageId String
  message   Message @relation(fields: [messageId], references: [id])
  token     String  @unique // short, unguessable: nanoid(10)
  targetUrl String
  clicks    Int     @default(0)
}
